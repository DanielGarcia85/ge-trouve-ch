# Modèle de configuration — copier en `.env` (jamais commité) et compléter.
# Aucune valeur sensible ne doit figurer ici, uniquement des exemples.

# serveur Ollama local (inférence)
OLLAMA_BASE_URL=http://localhost:11434

# LLM rédacteur servi par Ollama
OLLAMA_MODEL=gemma4:12b

# base vectorielle Chroma (persistante)
CHROMA_PERSIST_DIR=./data/chroma

# corpus brut scrapé (non versionné)
DATA_DIR=./data
